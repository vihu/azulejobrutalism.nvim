# Azulejo Brutalism OLED for tmux. Add to ~/.tmux.conf: source-file /path/to/azulejo-brutalism-oled.tmux
# Only styles are set, so your own status-left/right and window formats stay as they are.
set -g status-style "fg=#F3F0E8,bg=#07091F"
set -g window-status-style "fg=#8A8FB5,bg=#07091F"
set -g window-status-current-style "fg=#000000,bg=#9FB2E4,bold"
set -g window-status-activity-style "fg=#D49A1A,bg=#07091F,bold"
set -g window-status-bell-style "fg=#000000,bg=#D49A1A,bold"
set -g pane-border-style "fg=#1E2A9E"
set -g pane-active-border-style "fg=#D49A1A"
set -g popup-border-style "fg=#1E2A9E"
set -g message-style "fg=#F3F0E8,bg=#07091F"
set -g message-command-style "fg=#F3F0E8,bg=#07091F"
set -g mode-style "fg=#F3F0E8,bg=#1E2A9E"
set -g copy-mode-match-style "fg=#F3F0E8,bg=#1E2A9E"
set -g copy-mode-current-match-style "fg=#000000,bg=#D49A1A"
set -g menu-style "fg=#F3F0E8,bg=#07091F"
set -g menu-selected-style "fg=#000000,bg=#9FB2E4"
set -g menu-border-style "fg=#1E2A9E"
set -g clock-mode-colour "#9FB2E4"
set -g display-panes-colour "#8A8FB5"
set -g display-panes-active-colour "#D49A1A"
