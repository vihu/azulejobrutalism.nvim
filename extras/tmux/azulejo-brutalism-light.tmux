# Azulejo Brutalism Light for tmux. Add to ~/.tmux.conf: source-file /path/to/azulejo-brutalism-light.tmux
# Only styles are set, so your own status-left/right and window formats stay as they are.
set -g status-style "fg=#0C1030,bg=#E8E4D9"
set -g window-status-style "fg=#5A5E78,bg=#E8E4D9"
set -g window-status-current-style "fg=#F3F0E8,bg=#1E2A9E,bold"
set -g window-status-activity-style "fg=#D49A1A,bg=#E8E4D9,bold"
set -g window-status-bell-style "fg=#0C1030,bg=#D49A1A,bold"
set -g pane-border-style "fg=#0C1030"
set -g pane-active-border-style "fg=#D49A1A"
set -g popup-border-style "fg=#0C1030"
set -g message-style "fg=#0C1030,bg=#E8E4D9"
set -g message-command-style "fg=#0C1030,bg=#E8E4D9"
set -g mode-style "fg=#0C1030,bg=#9FB2E4"
set -g copy-mode-match-style "fg=#0C1030,bg=#D6DAE7"
set -g copy-mode-current-match-style "fg=#0C1030,bg=#D49A1A"
set -g menu-style "fg=#0C1030,bg=#E8E4D9"
set -g menu-selected-style "fg=#F3F0E8,bg=#1E2A9E"
set -g menu-border-style "fg=#0C1030"
set -g clock-mode-colour "#1E2A9E"
set -g display-panes-colour "#5A5E78"
set -g display-panes-active-colour "#D49A1A"
